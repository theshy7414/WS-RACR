# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# --- LLM (planner, constrained command fallback, memory compression) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- PostgreSQL + pgvector (plan RAG, interaction log, perception log) ---
# Either a full URL ...
# DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/ragdb
# ... or the parts:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=your_user
DB_PASSWORD=your_password

# --- Model files and data (defaults are relative to the repository root) ---
# WS_RACR_YOLO_WEIGHTS=models/workpiece.pt
# WS_RACR_STEP_CHECKPOINT=models/step_recognition.pth.tar
# WS_RACR_GESTURE_CHECKPOINT=models/gesture.pth
# WS_RACR_DATA_DIR=data            # calibration files live in <WS_RACR_DATA_DIR>/calibration/cal_info

# --- Cameras (optional; RealSense devices are auto-detected by model name when unset) ---
# D435I_SERIAL=

# --- Execution backend: tm_setpos (default) | moveit | tmscript ---
EXECUTION_BACKEND=tm_setpos
